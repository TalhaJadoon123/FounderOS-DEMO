# ---------------------------------------------------------------
# Founder OS — .env.docker.example
#
# Copy to .env.local and fill in before `docker compose up`.
# ---------------------------------------------------------------

# --- App ----
NODE_ENV=production
PORT=4100
NEXT_PUBLIC_SITE_URL=http://localhost:4100

# --- Access gate (set this to protect the OS on public URLs) ----
FOUNDER_OS_ACCESS_TOKEN=

# --- Jarvis ----
# 0 = running. Set to 1 to halt every run immediately (env always wins over
# the persisted switch in /jarvis/settings).
JARVIS_KILL_SWITCH=0
# Hard ceiling for any single autonomous spend. Money always needs a human yes.
JARVIS_SPEND_CAP_CENTS=5000
# Secret required by POST /api/jarvis/schedule. The in-process tick sends it
# automatically; an external cron must send `Authorization: Bearer <secret>`.
JARVIS_SCHEDULE_SECRET=
# How often the in-process autopilot tick runs (default 15 minutes).
JARVIS_SCHEDULE_INTERVAL_MS=900000
# Set to 1 when an external scheduler drives /api/jarvis/schedule.
JARVIS_DISABLE_TICK=0
# Comma-separated roots governed local actions may touch. Defaults to the
# workspace plus C:/ through G:/ on Windows.
JARVIS_ALLOWED_ROOTS=

# --- Deploy hook (Vercel / Railway / custom) ----
# Jarvis POSTs here to redeploy a project. Set on the host, never committed.
VERCEL_DEPLOY_HOOK_URL=

# --- Payments ----
STRIPE_SECRET_KEY=
STRIPE_VANTAGE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Announcements ----
SLACK_BOT_TOKEN=
SLACK_ANNOUNCE_CHANNEL=
RESEND_API_KEY=
JARVIS_ANNOUNCE_TO=

# --- LLM (agent chat via Vercel AI Gateway) ----
# Leave LLM_PROVIDER unset (or set it to gateway) for real model calls.
# "stub" is a deterministic offline test double and reports itself as such.
AI_GATEWAY_API_KEY=
LLM_PROVIDER=gateway
LLM_MODEL=anthropic/claude-sonnet-4-6

# --- Email (IMAP inboxes) ----
INBOX_1_HOST=imap.gmail.com
INBOX_1_USER=
INBOX_1_PASS=
INBOX_1_NAME=

# --- Slack ----
SLACK_BOT_TOKEN=

# --- Notion ----
NOTION_API_KEY=

# --- Beehiiv ----
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# --- ManyChat ----
MANYCHAT_API_KEY=
MANYCHAT_WEBHOOK_SECRET=

# --- Payments processors ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
SQUARE_ACCESS_TOKEN=
WHOP_API_KEY=
PAYKIT_VANTAGE_KEY=
PAYKIT_LC_KEY=
WISE_1_TOKEN=
WISE_2_TOKEN=

# --- Recording / voice ----
FATHOM_API_KEY=
PLAUD_REFRESH_TOKEN=
WHISPER_MODEL=

# --- Misc ----
MEMORY_API_TOKEN=
PHANTOM_WALLET_ADDRESS=
HERMES_DASH_URL=
